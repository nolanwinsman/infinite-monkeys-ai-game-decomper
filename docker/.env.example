# Copy this to docker/.env and edit, OR just run scripts/setup.sh with
# --model / --hours flags and let it write docker/.env for you.
# `docker compose` (v2) auto-loads a file named exactly `.env` from the same
# directory as the compose file, which is why this lives in docker/.

GAME_NAME=smb3
CONSOLE=nes
ROM_FILENAME=smb3.nes

# ---------------------------------------------------------------------------
# Ollama model - pick ONE by uncommenting it. All four are free, open-weight
# models (Apache-2.0 / MIT-family licenses), pulled once with `ollama pull`
# and then run locally at zero marginal cost no matter how many hours or
# tokens you throw at them. Sizing below assumes 4-bit quantization (Ollama's
# default pull), which is what makes these fit in the RAM/VRAM figures given.
# ---------------------------------------------------------------------------

# 1) Average computer, no dedicated GPU, ~16GB system RAM.
#    ~4.7GB on disk, runs adequately CPU-only on modest hardware.
OLLAMA_MODEL=qwen2.5-coder:7b

# 2) Headless server: decent CPU, NO GPU, but lots of RAM (64GB+), meant to
#    run nonstop for days/weeks/months. deepseek-coder-v2:16b is a
#    Mixture-of-Experts model - only a fraction of its ~16B parameters
#    activate per generated token, so CPU-only throughput is noticeably
#    better than a dense model of similar quality. Good fit when you have
#    RAM and wall-clock time to spare but no GPU.
# OLLAMA_MODEL=deepseek-coder-v2:16b

# 3) Average gaming PC with a GPU (8-12GB VRAM - RTX 3060/4060/4070 class).
#    ~9GB on disk, fits comfortably in a 12GB card; noticeably stronger than
#    the 7b model above.
# OLLAMA_MODEL=qwen2.5-coder:14b

# 4) Super powerful consumer PC (24GB+ VRAM - RTX 3090/4090, high-end Mac
#    with unified memory). Qwen's own benchmarks put this at/near GPT-4o on
#    coding tasks among open models. ~20GB on disk.
# OLLAMA_MODEL=qwen2.5-coder:32b

# ---------------------------------------------------------------------------
# Run duration - wall-clock budget per invocation of scripts/setup.sh or
# scripts/continue.sh. The scoreboard persists between runs, so going past
# this limit just means running scripts/continue.sh again afterward.
# ---------------------------------------------------------------------------
TIME_LIMIT_HOURS=24

# Reference points if you want a single very long unattended run instead of
# repeated continues (make sure your machine/power/network can actually stay
# up this long before picking these):
# TIME_LIMIT_HOURS=720    # ~1 month  (30 days x 24h)
# TIME_LIMIT_HOURS=8760   # ~1 year   (365 days x 24h)

# Per-unit retry cap before a unit is marked "stuck" and the loop moves on.
MAX_ATTEMPTS_PER_UNIT=8
